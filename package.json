{
  "name": "linty",
  "private": true,
  "version": "0.0.52",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn icons:check && tsc && vite build",
    "preview": "vite preview",
    "storage:benchmarks": "node scripts/storage-benchmarks.mjs",
    "tauri": "tauri",
    "build:mac": "bash scripts/build-mac.sh",
    "build:mac:universal": "tauri build --target universal-apple-darwin --bundles dmg app --features local-stt,parakeet && mkdir -p release && cp -f src-tauri/target/release/bundle/dmg/*.dmg release/",
    "test": "node --experimental-strip-types --test tests/usage.test.mjs tests/history-audio.test.mjs tests/languages.test.mjs tests/corrections.test.mjs tests/payoff.test.mjs tests/force-update.test.mjs tests/reformat.test.mjs tests/settings-save.test.mjs tests/dictation-trigger.test.mjs tests/dictation-evaluation.test.mjs tests/website-demo.test.mjs tests/website-platform.test.mjs tests/website-product.test.mjs tests/release-publish.test.mjs tests/release-version.test.mjs tests/update-acknowledgment.test.mjs tests/release-notes.test.mjs",
    "test:ui": "node tests/ui.smoke.mjs",
    "test:motion": "node tests/ui.motion.mjs",
    "test:usability": "node tests/ui.usability.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "test:transcripts": "node tests/ui.transcript-details.mjs",
    "test:audio-history": "node tests/ui.audio-history.mjs",
    "test:dictation": "node tests/ui.dictation.mjs",
    "test:correction-feedback": "node tests/ui.correction-feedback.mjs",
    "test:recovery": "node tests/ui.recovery.mjs",
    "test:onboarding": "node tests/ui.onboarding-models.mjs",
    "test:cleanup": "node tests/ui.cleanup-warmup.mjs",
    "test:security": "node tests/ui.security.mjs",
    "release:check": "node scripts/release-notes.mjs",
    "test:updates": "node tests/ui.updates.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  }
}
